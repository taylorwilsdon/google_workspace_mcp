{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspace-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "containers": [
    {
      "class_name": "WorkspaceMcpContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "max_instances": 3,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_MCP_CONTAINER",
        "class_name": "WorkspaceMcpContainer"
      }
    ]
  },
  "exports": {
    "WorkspaceMcpContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "OAuthStateDO": { "type": "durable-object", "state": "deleted" },
    "WorkspaceMCPContainer": { "type": "durable-object", "state": "deleted" }
  },
  // The Google OAuth client identifies this deployment to Google when it
  // checks a member access token. The member token itself is not a Worker
  // secret: the orgs Agent DO sends it on each request.
  "secrets": {
    "required": [ "GOOGLE_OAUTH_CLIENT_SECRET"]
  },
  "vars": { "GOOGLE_OAUTH_CLIENT_ID": "724161308677-ctg37npmtf8fdi7dt98qlodh9fv1toa1.apps.googleusercontent.com" }
}
