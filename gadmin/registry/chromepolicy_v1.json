      "body": {
        "policySchemaFilter": {
          "type": "string",
          "required": true,
          "pattern": "^chrome(\\.[A-Za-z0-9]+)*(\\.\\*)?$"
        },
        "policyTargetKey": {
          "type": "object",
          "required": true,
          "fields": {
            "targetResource": {
              "type": "string",
              "required": true,
              "pattern": "^(orgunits/[A-Za-z0-9_\\-]+|groups/[A-Za-z0-9]+)$"
            },
            "additionalTargetKeys": {
              "type": "object",
              "fields": {
                "app_id": {
                  "type": "string",
                  "pattern": "^(chrome:[a-p]{32}|android:[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+)$"
                }
              }
            }
          }
        },
        "pageSize": "integer",
        "pageToken": "string"
      },
      "response": {
        "items_key": "resolvedPolicies",
        "fields": [
          "targetKey",
          "sourceKey",
          "addedSourceKey",
          "value"
        ]
      },
      "boundary": [
        {
          "kind": "customer",
          "param": "customer",
          "as": "name"
        },
        {
          "kind": "policy_target",
          "field": "policyTargetKey.targetResource"
        }
      ]
    },
