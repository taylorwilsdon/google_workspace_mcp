  "excluded": {
    "chromepolicy.customers.policies.networks.defineCertificate": {
      "category": "secret-in-payload",
      "reason": "Defines a certificate from a raw PEM value with untyped settings, which would be stored in a proposal and cannot be validated."
    },
    "chromepolicy.customers.policies.networks.defineNetwork": {
      "category": "secret-in-payload",
      "reason": "Defines a Wi-Fi or Ethernet network whose untyped settings carry passphrases and EAP credentials, which would be stored in a proposal."
    },
    "chromepolicy.customers.policies.networks.removeCertificate": {
      "category": "unguarded-target",
      "reason": "Removes a certificate named only by a caller-supplied GUID, and no registered read proves the certificate belongs to the target org unit."
    },
    "chromepolicy.customers.policies.networks.removeNetwork": {
      "category": "unguarded-target",
      "reason": "Removes a network named only by a caller-supplied GUID, and no registered read proves the network belongs to the target org unit."
    },
    "chromepolicy.media.upload": {
      "category": "unvalidated-schema",
      "reason": "Uploads arbitrary file bytes for a policy and returns a download URL; the file content cannot be validated against a schema before it is stored."
    }
