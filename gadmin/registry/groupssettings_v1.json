          "description",
          "whoCanJoin",
          "whoCanViewMembership",
          "whoCanViewGroup",
          "whoCanPostMessage",
          "allowExternalMembers",
          "whoCanDiscoverGroup",
          "whoCanContactOwner",
          "whoCanLeaveGroup",
          "whoCanModerateMembers",
          "whoCanModerateContent",
          "whoCanAssistContent",
          "messageModerationLevel",
          "spamModerationLevel",
          "includeInGlobalAddressList",
          "isArchived",
          "archiveOnly",
