          "email",
          "name",
          "description",
          "whoCanJoin",
          "whoCanViewMembership",
          "whoCanViewGroup",
          "whoCanPostMessage",
          "allowExternalMembers",
          "whoCanDiscoverGroup",
          "whoCanContactOwner",
          "whoCanLeaveGroup",
