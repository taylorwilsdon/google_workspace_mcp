          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "enableCollaborativeInbox": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "sendMessageDenyNotification": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
